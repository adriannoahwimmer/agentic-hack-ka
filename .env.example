# Vorlage für die lokale .env: kopieren nach .env und Werte eintragen.
# .env ist gitignored; diese Datei wird committet und enthält NIE echte Werte.
# Bereits gesetzte Umgebungsvariablen (z. B. Codesphere-UI) haben Vorrang vor der .env.
# Leere Werte bedeuten: Default aus config.py (dort auch die Begründungen).

# Pflicht. Key aus aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Modelle (Default: gemini-3.5-flash-lite / gemini-3.5-flash-lite / gemini-3.1-flash-lite)
# /agent, Polizei-/Gang-Agenten. Mehr Reasoning: gemini-4-hydrogen oder gemini-4-carbon
# (beide deutlich langsamer, dann GEMINI_TIMEOUT_MS anheben)
GEMINI_MODEL_AGENT=
# /chat, NPC-Dialoge
GEMINI_MODEL_CHAT=
# Ausweichmodell nach 5xx
GEMINI_MODEL_FALLBACK=
# low | medium | high. Default: low
GEMINI_THINKING_LEVEL=

# --- Agent-Limits
# Max. Loop-Schritte (= Requests) pro /agent. Default: 8
MAX_AGENT_STEPS=

# --- Timeouts und Retries
# Deadline pro Request in ms, geht auch als X-Server-Timeout an Gemini. Default: 30000
GEMINI_TIMEOUT_MS=
# SDK-Versuche bei Timeout/Verbindungsabbruch, inkl. des ersten. Default: 2
GEMINI_TRANSPORT_ATTEMPTS=
# Versuche pro Modell bei 500/502/503, inkl. des ersten. Default: 3
GEMINI_RETRY_ATTEMPTS=
# Backoff in Sekunden: Startwert und Obergrenze. Default: 2.0 / 8.0
GEMINI_RETRY_BASE_DELAY=
GEMINI_RETRY_MAX_DELAY=
