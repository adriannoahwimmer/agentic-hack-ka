# Vorlage für die lokale .env: kopieren nach .env und Werte eintragen.
# .env ist gitignored; diese Datei wird committet und enthält NIE echte Werte.
# Bereits gesetzte Umgebungsvariablen (z. B. Codesphere-UI) haben Vorrang vor der .env.
# Leere Werte bedeuten: Default aus config.py (dort auch die Begründungen).

# Pflicht. Key aus aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Modelle (Default: gemini-3.5-flash-lite / gemini-3.5-flash-lite / gemini-3.1-flash-lite)
# /agent (Starter). Spiel-Agenten haben eigene Schlüssel unten. Mehr Reasoning: gemini-4-hydrogen oder gemini-4-carbon
# (beide deutlich langsamer, dann GEMINI_TIMEOUT_MS anheben)
GEMINI_MODEL_AGENT=
# /chat, NPC-Dialoge
GEMINI_MODEL_CHAT=
# Ausweichmodell nach 5xx
GEMINI_MODEL_FALLBACK=
# low | medium | high. Default: low
GEMINI_THINKING_LEVEL=

# --- Agent-Limits
# Max. Loop-Schritte (= Requests) pro /agent. Default: 8
MAX_AGENT_STEPS=

# --- Timeouts und Retries
# Deadline pro Request in ms, geht auch als X-Server-Timeout an Gemini. Default: 15000
GEMINI_TIMEOUT_MS=
# Kleinste Server-Deadline, die Gemini annimmt (darunter 400). gemini.py schickt nie weniger. Default: 10000
GEMINI_MIN_SERVER_DEADLINE_MS=
# SDK-Versuche bei Timeout/Verbindungsabbruch, inkl. des ersten. Default: 2
GEMINI_TRANSPORT_ATTEMPTS=
# Versuche pro Modell bei 500/502/503, inkl. des ersten. Default: 3
GEMINI_RETRY_ATTEMPTS=
# Backoff in Sekunden: Startwert und Obergrenze. Default: 2.0 / 8.0
GEMINI_RETRY_BASE_DELAY=
GEMINI_RETRY_MAX_DELAY=

# =============================================================================
# Spiel (Fächerstadt Agents)
# =============================================================================

# --- Kern
# live | offline. offline = nur geskriptete Fallbacks, KEIN Gemini-Request. Default: offline
AGENTS_MODE=
# Hartes Request-Budget pro Serverprozess. Default: 30 / 400
GENAI_MAX_CALLS_PER_MIN=
GENAI_MAX_CALLS_TOTAL=
# JSONL-Log aller GenAI-Calls (relativ zum Projektordner). Default: logs/genai.jsonl
GENAI_LOG_PATH=
# Prompt-Kürzung im Log. Default: 4000
GENAI_LOG_MAX_PROMPT_CHARS=
# Max. WebSocket-Events pro Sekunde und Client. Default: 20
WS_MAX_EVENTS_PER_S=
# 1 = POST /debug/action und GET /debug/state aktiv (nur lokal!). Default: 0
DEBUG_ENDPOINTS=

# --- Modelle je Agent (Default: GEMINI_MODEL_AGENT)
GEMINI_MODEL_POLICE=
GEMINI_MODEL_QUEST=
# Maps Grounding. Default: gemini-3.5-flash-lite
GEMINI_MODEL_MAPS=
# Polizeifunk. Default: gemini-3.8-flash-lite-tts
GEMINI_MODEL_TTS=
# Prebuilt-Stimme. Default: Orus
TTS_VOICE=

# --- Agent-Runner (Polizei)
# Sammelfenster in s, mindestens 5. Default: 5.0
AGENT_DEBOUNCE_S=
# Mindestabstand zwischen zwei Zyklen in s. Default: 8.0
POLICE_MIN_INTERVAL_S=
# Spiel-Deadline pro Agent-Request/-Zyklus in ms, lokal durchgesetzt, danach Fallback.
# An Gemini gehen trotzdem mindestens GEMINI_MIN_SERVER_DEADLINE_MS. Default: 6000
AGENT_DEADLINE_MS=
# Versuche pro Modell im Spiel (ohne Backoff). Default: 1
AGENT_ATTEMPTS=

# --- Fahndung und Clamps
# Default: 5 / 2 / 30.0 / 6 / 160
WANTED_MAX=
WANTED_MAX_STEP=
WANTED_DECAY_S=
POLICE_MAX_UNITS=
RADIO_MAX_CHARS=

# --- Quest und Maps
# Default: 3 / 8000 / 5 / cache/maps_facts.json
QUEST_MAX_STEPS=
QUEST_DEADLINE_MS=
QUEST_MAX_TARGETS=
MAPS_CACHE_PATH=

# --- TTS
# Default: 8000 / cache/tts
TTS_DEADLINE_MS=
TTS_CACHE_DIR=
